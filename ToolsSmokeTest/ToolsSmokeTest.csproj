<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupHookSupport Condition="'$(Configuration)' == 'Release'">false</StartupHookSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\CDPIUI.Shared\Security\ReadOnlyPathLease.cs" Link="Shared\ReadOnlyPathLease.cs" />
    <Compile Include="..\CDPIUI.Shared\Security\WindowsPathNames.cs" Link="Shared\WindowsPathNames.cs" />
    <Compile Include="..\CDPIUI.Shared\Security\WindowsFileHandles.cs" Link="Shared\WindowsFileHandles.cs" />
    <Compile Include="..\CDPIUI.Shared\Security\WindowsFileRemoval.cs" Link="Shared\WindowsFileRemoval.cs" />
    <Compile Include="..\CDPIUI.Shared\Security\ProtectedStagingArea.cs" Link="Shared\ProtectedStagingArea.cs" />
  </ItemGroup>
</Project>

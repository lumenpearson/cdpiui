<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>EditHostFile</RootNamespace>
    <AssemblyName>EditHostFile</AssemblyName>
    <!-- A 32-bit process would see SysWOW64 instead of the real hosts file. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <!-- The manifest requires administrator rights. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Like the tray: one framework-dependent executable. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Make changes in system's hosts file</AssemblyTitle>
    <Description>Make changes in system's hosts file</Description>
    <Product>Hosts file editor (CDPI UI)</Product>
    <Company></Company>
    <Copyright>Copyright ©  2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The CDPI UI block. Program.AddNewLines reads it as "EditHostFile.Data.hosts". -->
    <None Remove="Data\**" />
    <EmbeddedResource Include="Data\*.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDPIUI.Tests" />
  </ItemGroup>

</Project>

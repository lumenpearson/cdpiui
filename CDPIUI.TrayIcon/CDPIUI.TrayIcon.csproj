<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
	<TargetPlatformVersion>10.0</TargetPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
	<UseWindowsForms>true</UseWindowsForms>
	<DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <!-- Reports unused code; the rules are set in the root .editorconfig. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\trayLogoNormal.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyName>CDPIUI_TrayIcon</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\trayLogoError.ico" />
    <None Remove="Assets\trayLogoNormal.ico" />
    <None Remove="Assets\trayLogoStarted.ico" />
    <None Remove="Assets\trayLogoStopped.ico" />
  </ItemGroup>

  <ItemGroup>
	  <EmbeddedResource Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\trayLogoNormal.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="TaskScheduler" />
    <!-- A dependency brings 4.7.0, which has a known critical vulnerability (GHSA-rxg9-xrhp-64gj). -->
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDPIUI.Shared\CDPIUI.Shared.csproj" />
  </ItemGroup>
	<ItemGroup>
		<None Update="Assets\**\*.*">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>

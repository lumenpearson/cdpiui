<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reports unused code; the rules are set in the root .editorconfig. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDPIUI.Core\CDPIUI.Core.csproj" />
    <ProjectReference Include="..\CDPIUI.Shared\CDPIUI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BlockCheck2\Catalog\strategy-catalog.v1.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDPIUI.Tests" />
  </ItemGroup>

</Project>

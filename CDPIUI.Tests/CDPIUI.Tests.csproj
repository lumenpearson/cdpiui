<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows: the tests also reference Update and EditHostFile, which target net8.0-windows. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Update uses Windows Forms. The tested Update code does not, and the tests must also run
         on Linux, where the Windows Desktop runtime is not available. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Reports unused code; the rules are set in the root .editorconfig. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDPIUI.Shared\CDPIUI.Shared.csproj" />
    <ProjectReference Include="..\CDPIUI.Core\CDPIUI.Core.csproj" />
    <ProjectReference Include="..\CDPIUI.AddOns\CDPIUI.AddOns.csproj" />
    <ProjectReference Include="..\Update\Update.csproj" />
    <ProjectReference Include="..\EditHostFile\EditHostFile.csproj" />
  </ItemGroup>

  <!-- Test the Native AOT launcher rules and pure GUI recovery guards as linked source. -->
  <ItemGroup>
    <Compile Include="..\CDPIUI.ElevatedLauncher\LaunchPolicy.cs" Link="Tools\ElevatedLauncher\LaunchPolicy.cs" />
    <Compile Include="..\CDPIUI\Helper\Basic\EmergencyRecovery.cs" Link="UI\EmergencyRecovery.cs" />
    <Compile Include="..\CDPIUI\Helper\Basic\StartupInitialization.cs" Link="UI\StartupInitialization.cs" />
    <Compile Include="..\CDPIUI\ViewModels\LanguageSelectModel.cs" Link="UI\LanguageSelectModel.cs" />
    <Compile Include="..\CDPIUI\Converters\StringToUpperConverter.cs" Link="UI\StringToUpperConverter.cs" />
  </ItemGroup>

</Project>

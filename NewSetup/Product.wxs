<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
  The package version is the file version of CDPIUI.exe (bind.FileVersion.CdpiUiExe).
  The ProductCode is a new GUID for each build, so every installation is a major upgrade:
  the previous version is removed and the new one is installed.
  -->
  <Package Name="CDPI UI" Language="0" Version="!(bind.FileVersion.CdpiUiExe)" Manufacturer="Storik4" UpgradeCode="{AB14590E-0D10-416F-9A0E-07E63074B603}">
    <SummaryInformation />
    <MediaTemplate EmbedCab="yes" />
    <!-- Major Upgrade Rule to disallow downgrades. The package version follows CDPIUI.exe, and Windows Installer
         ignores the fourth field, so builds that differ only in it must still replace each other. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />
    <!-- Uncomment below two lines to require .NET 4.8 or Later to install -->
    <!-- <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" /> -->
    <!-- <Launch Condition="Installed OR WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" Message="[ProductName] requires .NET Framework 4.8 or later." /> -->
    <Icon Id="Icon.ico" SourceFile="Resources\Icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Icon.ico"></Property>
    <Property Id="DISABLEADVTSHORTCUTS" Value="0"></Property>

    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <UIRef Id="UI" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CompanyFolder" Name="Storik4">
        <Directory Id="INSTALLLOCATION" Name="CDPI UI" />
      </Directory>
    </StandardDirectory>
    <Feature Id="NewSetup" Title="CDPI UI" Description="Installs all the files needed for CDPI UI" Level="1" AllowAdvertise="no" ConfigurableDirectory="INSTALLLOCATION">
      <ComponentGroupRef Id="NewSetupFiles" />
      <ComponentRef Id="InstallLocationPermissions" />
      <ComponentRef Id="InstallLocationRegistration" />
    </Feature>
    <!-- The same Release build is packed as the MSI and as the portable ZIP. The application compares
         this value with its own folder to know that it was installed by the MSI (CDPIUI.Core/State.cs). -->
    <Component Id="InstallLocationRegistration" Directory="INSTALLLOCATION" Guid="{5F0C6C2E-7B3A-4E55-9C61-2E8B0A4D7C19}">
      <RegistryValue Root="HKLM" Key="Software\Storik4\CDPI UI" Name="InstallLocation" Type="string" Value="[INSTALLLOCATION]" KeyPath="yes" />
    </Component>
    <!-- The elevated tray runs files from this directory. A custom location such as C:\CDPI UI would inherit
         write access for all users from its parent, so it gets the same rights as Program Files:
         full control for SYSTEM and Administrators, read and execute for Users. -->
    <Component Id="InstallLocationPermissions" Directory="INSTALLLOCATION" Guid="{AC0B143D-91DD-4B7A-8709-0ECBDFC99C3D}">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
    </Component>
    <!-- Started through Explorer, the GUI runs as the signed-in user and not with the rights of the
         installer; it is not started by silent (/qn) or basic-UI installations. -->
    <CustomAction Id="LaunchApp" Directory="INSTALLLOCATION" ExeCommand="[WindowsFolder]explorer.exe &quot;[INSTALLLOCATION]CDPIUI.exe&quot;" Return="asyncNoWait" />
    <!-- Closes the tray so it stops the components and restores the proxy settings, then ends the remaining
         application processes and removes the WinDivert driver and the autorun task created by the application. -->
    <CustomAction Id="UninstallCleanup" FileRef="TrayIconExe" ExeCommand="--uninstall-cleanup" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE AND UILevel &gt;= 4" />
      <Custom Action="UninstallCleanup" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
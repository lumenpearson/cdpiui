<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: the launcher shows no console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>CDPIUI.ElevatedLauncher</RootNamespace>
    <AssemblyName>CDPIUI_ElevatedLauncher</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Reports unused code; the rules are set in the root .editorconfig. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The manifest requires administrator rights. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Native AOT: the published file has no .NET host and no CLR, so DOTNET_ROOT, CORECLR_*,
         DOTNET_STARTUP_HOOKS and the other runtime variables of the user cannot load code into it. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupHookSupport>false</StartupHookSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>CDPI UI elevated start</AssemblyTitle>
    <Description>Starts the elevated programs of CDPI UI without the .NET variables of the user</Description>
    <Product>CDPI UI</Product>
    <Company></Company>
    <Copyright>Copyright ©  2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>

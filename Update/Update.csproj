<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Update</RootNamespace>
    <AssemblyName>Update</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>embedded</DebugType>
    <!-- Like the tray: one framework-dependent executable. Update.exe replaces the application
         files while it runs, so it must not load any DLL from the installation folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The tool has no manifest of its own: the default manifest (asInvoker) gives it the rights of the tray. -->
      <!-- Runs elevated: DOTNET_STARTUP_HOOKS set by a user process must not load code into it.
         Debug keeps startup hooks for Hot Reload. -->
    <StartupHookSupport Condition="'$(Configuration)' == 'Release'">false</StartupHookSupport>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Update</AssemblyTitle>
    <Description>Update helper for CDPIUI application</Description>
    <Product>Update</Product>
    <Company></Company>
    <Copyright>Copyright ©Storik4 2025</Copyright>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);UPDATE_TOOL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDPIUI.Tests" />
  </ItemGroup>

  <!-- The tray checks the same layers and archive limits that this tool applies; the files are
       shared as source, because the tool must not load CDPIUI.Shared.dll from the folder it replaces. -->
  <ItemGroup>
    <Compile Include="..\CDPIUI.Shared\Basic\Filesystem\UpdatePackageLayers.cs" Link="Shared\UpdatePackageLayers.cs" />
    <Compile Include="..\CDPIUI.Shared\Basic\Filesystem\ArchivePaths.cs" Link="Shared\ArchivePaths.cs" />
  </ItemGroup>

</Project>
